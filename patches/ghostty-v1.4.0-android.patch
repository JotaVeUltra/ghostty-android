diff --git a/pkg/freetype/build.zig b/pkg/freetype/build.zig
index 8272700..ccab773 100644
--- a/pkg/freetype/build.zig
+++ b/pkg/freetype/build.zig
@@ -45,6 +45,11 @@ pub fn build(b: *std.Build) !void {
         .link_libs = if (lib == .static) &.{lib.static} else &.{},
         .include_paths = &.{b.path("")},
         .default_init = true,
+        // Android: translate-c does not see the --libc file, so pass it explicitly.
+        .libc_file = if (b.graph.environ_map.get("GHOSTTY_ANDROID_LIBC")) |p|
+            .{ .direct = .{ .cwd_relative = p } }
+        else
+            .detect_darwin,
     });
 }
 
